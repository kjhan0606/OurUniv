# Python/editor state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.idea/
.vscode/

# Logs and scheduler output
/logs/
*.log
*.out
*.err

# Catalogs, simulations, checkpoints, and generated arrays
*.csv
*.npy
*.npz
*.h5
*.hdf5
*.fits
*.pt
*.pth
*.ckpt
*.bin
/data_cf4/
/data_hires/
/data_sr/
/data_train/
