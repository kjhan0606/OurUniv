! CF4 trace-derived LG zoom production DMO run.
! Only initial and z=0 full snapshots are requested.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.false.
nrestart=0
nstepmax=10000000
nremap=1
nsubcycle=1,1,9*2
ncontrol=1
ordering='ksection'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=1.0
foutput=100000000
fbackup=100000000
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v3/level_008'
initfile(2)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v3/level_009'
initfile(3)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v3/level_010'
initfile(4)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v3/level_011'
initfile(5)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v3/level_012'
/

&AMR_PARAMS
levelmin=8
levelmax=19
nexpand=1,1,9*1
ngridtot=120000000
nparttot=80000000
/

&COSMO_PARAMS
omega_b=0.0
omega_m=0.31
omega_l=0.69
h0=0.746
/

&REFINE_PARAMS
m_refine=11*8.
ivar_refine=0
mass_cut_refine=2.9103830457d-11
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&POISSON_PARAMS
epsilon=1.d-4
maxiter_fine=30
/
