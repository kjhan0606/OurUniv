! CF4 uniform L8 nonlinear DMO pilot from the frozen GRAFIC IC.
! Separate from the two-step adapter preflight; no zoom or z=0 claim.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.false.
nrestart=0
nstepmax=32
nremap=1
nsubcycle=1
ncontrol=1
ordering='ksection'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
verbose=.false.
/

&OUTPUT_PARAMS
noutput=3
aout=0.05,0.10,0.20
foutput=1000000
fbackup=1000000
/

&INIT_PARAMS
filetype='grafic'
! read_params remaps slot 1 to levelmin=8.
initfile(1)='/gpfs/kjhan/CF4/kf_design/production_ic_grafic_v1'
/

&AMR_PARAMS
levelmin=8
levelmax=8
nexpand=1
ngridtot=5000000
nparttot=20000000
/

&COSMO_PARAMS
omega_b=0.0
omega_m=0.31
omega_l=0.69
h0=0.746
/

&REFINE_PARAMS
m_refine=9*8.
ivar_refine=0
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&POISSON_PARAMS
epsilon=1.d-4
/
