! CF4 trace-derived LG zoom IC adapter preflight.
! Parent L8 plus sparse nested L9-L12 IC, runtime ceiling L19.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.false.
nrestart=0
nstepmax=2
nremap=1
nsubcycle=1,1,9*2
ncontrol=1
ordering='ksection'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=1.0
foutput=1000000
fbackup=1000000
/

&INIT_PARAMS
filetype='grafic'
! slots are relative to levelmin=8 in this RAMSES build.
initfile(1)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v2/level_008'
initfile(2)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v2/level_009'
initfile(3)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v2/level_010'
initfile(4)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v2/level_011'
initfile(5)='/gpfs/kjhan/CF4/zoom/cf4_lg_zoom_pilot_v2/level_012'
/

&AMR_PARAMS
levelmin=8
levelmax=19
nexpand=1,1,9*1
ngridtot=20000000
nparttot=30000000
/

&COSMO_PARAMS
omega_b=0.0
omega_m=0.31
omega_l=0.69
h0=0.746
/

&REFINE_PARAMS
m_refine=11*8.
ivar_refine=0
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
mass_cut_refine=2.9103830457d-11
/

&POISSON_PARAMS
epsilon=1.d-4
/
