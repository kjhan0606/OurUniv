! Two-step L9 parent reader/wiring test for CF4+LG candidate 40274.
! The future output clocks prevent any snapshot from this preflight.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.false.
nrestart=0
nstepmax=2
nremap=1
nsubcycle=1
ncontrol=1
ordering='ksection'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=1.1
tout=1.0d100
foutput=1000000
fbackup=1000000
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/gpfs/kjhan/CF4/ramses/ic/s40274_parent'
/

&AMR_PARAMS
levelmin=9
levelmax=9
nexpand=1
ngridtot=20200000
nparttot=165000000
/

&COSMO_PARAMS
omega_b=0.0
omega_m=0.31
omega_l=0.69
h0=0.746
/

&REFINE_PARAMS
m_refine=10*8.
ivar_refine=0
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&POISSON_PARAMS
epsilon=1.d-4
/

&STELLAR_ENRICHMENT_PARAMS
feedback_mode='legacy'
/
