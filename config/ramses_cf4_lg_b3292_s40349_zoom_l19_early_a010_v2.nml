! Restart the completed seed-40349 a=0.05 dump and extend only to a=0.10.
! This remains a trace-only early-nonlinear refinement gate, not a z=0 run.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.false.
nrestart=1
nstepmax=1000
nremap=1
nsubcycle=1,1,9*2
ncontrol=1
ordering='ksection'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=0.10
match_aout=.true.
tout=1.d100
foutput=1000000000
fbackup=1000000000
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/gpfs/kjhan/CF4/zoom/cf4_lg_b3292_s40349_traceonly_l12_v2/level_009'
initfile(2)='/gpfs/kjhan/CF4/zoom/cf4_lg_b3292_s40349_traceonly_l12_v2/level_010'
initfile(3)='/gpfs/kjhan/CF4/zoom/cf4_lg_b3292_s40349_traceonly_l12_v2/level_011'
initfile(4)='/gpfs/kjhan/CF4/zoom/cf4_lg_b3292_s40349_traceonly_l12_v2/level_012'
/

&AMR_PARAMS
levelmin=9
levelmax=19
nexpand=1,1,9*1
ngridtot=48000000
nparttot=190000000
ngridmax_auto=.true.
npartmax_auto=.true.
/

&COSMO_PARAMS
omega_b=0.0
omega_m=0.31
omega_l=0.69
h0=0.746
/

&REFINE_PARAMS
