interpol_var=1
interpol_type=0
q_refine_holdback=.false.
dr_proper=0.0
/

&POISSON_PARAMS
epsilon=1.d-4
maxiter_fine=100
abort_on_mg_nonconvergence=.true.
/

&STELLAR_ENRICHMENT_PARAMS
feedback_mode='legacy'
/
