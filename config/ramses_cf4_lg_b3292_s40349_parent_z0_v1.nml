! Uniform L9 z=0 DMO parent for the selected seed-40349 LG realization.
! Two dumps retain the initial particle IDs and the final validation state.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.false.
nrestart=0
nstepmax=100000
nremap=1
nsubcycle=1
ncontrol=1
ordering='ksection'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
verbose=.false.
/

&OUTPUT_PARAMS
noutput=2
aout=0.02,1.0
foutput=1000000
fbackup=1000000
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/gpfs/kjhan/CF4/ramses/ic/sv1/i248_s40349'
/

&AMR_PARAMS
levelmin=9
levelmax=9
nexpand=1
ngridtot=20200000
nparttot=165000000
/

&COSMO_PARAMS
omega_b=0.0
omega_m=0.31
omega_l=0.69
h0=0.746
/

&REFINE_PARAMS
m_refine=10*8.
ivar_refine=0
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&POISSON_PARAMS
epsilon=1.d-4
/

&STELLAR_ENRICHMENT_PARAMS
feedback_mode='legacy'
/
