! CF4 production GRAFIC IC adapter preflight.
! Uniform N=256 grid in a 384 cMpc/h box => level 8 (1.5 cMpc/h cells).
! This is a short DMO PM/RAMSES wiring test, not a zoom or z=0 production run.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.false.
nrestart=0
nstepmax=2
nremap=1
nsubcycle=1
ncontrol=1
ordering='ksection'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
verbose=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=1.0
foutput=1000000
fbackup=1000000
/

&INIT_PARAMS
filetype='grafic'
! read_params remaps initfile(i) to levelmin+i-1; levelmin=8 => slot 1.
initfile(1)='/gpfs/kjhan/CF4/kf_design/production_ic_grafic_v1'
/

&AMR_PARAMS
levelmin=8
levelmax=8
nexpand=1
! 256^3 cells require 2,097,152 level-8 grids; leave headroom for AMR buffers.
ngridtot=5000000
! One particle per L8 cell is 16,777,216; retain MPI/AMR headroom.
nparttot=20000000
/

&COSMO_PARAMS
omega_b=0.0
omega_m=0.31
omega_l=0.69
h0=0.746
/

&REFINE_PARAMS
m_refine=9*8.
ivar_refine=0
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&POISSON_PARAMS
epsilon=1.d-4
/
